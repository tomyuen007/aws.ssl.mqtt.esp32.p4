# Copy to .env and fill in values.
# .env does NOT contain secrets — WiFi credentials live in secret.json.

# ── Camera source ──────────────────────────────────────────────────────────
# network  Built-in camera via windows-camera-server.py on Windows (default)
# v4l2     USB camera attached via usbipd-win
# pattern  Animated test pattern (no camera needed)
CAMERA_SOURCE=network

# Port that windows-camera-server.py listens on (Windows side)
WIN_CAMERA_PORT=8081

# ── IoT device identity ────────────────────────────────────────────────────
THING_NAME=esp32p4-device-01

# ── LocalStack ─────────────────────────────────────────────────────────────
# Required for LocalStack Pro IoT features; leave blank for Community edition
LOCALSTACK_AUTH_TOKEN=

# ── AWS CLI (fake values are fine for LocalStack) ──────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
