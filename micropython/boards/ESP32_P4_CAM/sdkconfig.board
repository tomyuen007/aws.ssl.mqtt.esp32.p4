# ── Target ─────────────────────────────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32p4"

# ── CPU ────────────────────────────────────────────────────────────────────────
# ESP32-P4 HP core — IDF v5.x uses a Kconfig choice, not an integer override
CONFIG_ESP32P4_DEFAULT_CPU_FREQ_360=y

# ── Memory ─────────────────────────────────────────────────────────────────────
# ESP32-P4 PSRAM (connected via Octal SPI)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_ESP32_SPIRAM_SUPPORT is for the original ESP32 chip — do NOT set on P4

# ── Camera ─────────────────────────────────────────────────────────────────────
CONFIG_CAMERA_TASK_STACK_SIZE=4096
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=32768

# ── MQTT (esp-mqtt component bundled with IDF) ──────────────────────────────
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_TCP=y
CONFIG_MQTT_BUFFER_SIZE=8192

# ── Build ──────────────────────────────────────────────────────────────────────
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
