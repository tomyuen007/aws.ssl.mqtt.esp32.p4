# Lightweight OpenCV camera server.
# Grabs frames from /dev/video0 (USB webcam via usbipd-win on WSL2) and
# serves them as JPEG over HTTP so the ESP32-P4 QEMU emulator can use them.
# Falls back to a generated test pattern when no camera device is present.

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        # V4L2 runtime and OpenCV shared-library deps
        libgl1 libglib2.0-0 \
        libv4l-dev v4l-utils \
    && rm -rf /var/lib/apt/lists/*

COPY camera.proxy/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY camera.proxy/ /app/

# CAMERA_SOURCE  network | v4l2 | pattern | auto   (default auto)
# CAMERA_URL     URL to poll in network mode        (default host.docker.internal:8081)
# CAMERA_DEVICE  V4L2 index or path                 (default 0 → /dev/video0)
# CAMERA_WIDTH / CAMERA_HEIGHT                      (default 640 × 480)
# JPEG_QUALITY   1-100                              (default 85)
# PORT           HTTP listen port                   (default 8080)
ENV CAMERA_SOURCE=auto \
    CAMERA_URL=http://host.docker.internal:8081/frame.jpg \
    CAMERA_DEVICE=0 \
    CAMERA_WIDTH=640 \
    CAMERA_HEIGHT=480 \
    JPEG_QUALITY=85 \
    PORT=8080

EXPOSE 8080

CMD ["python3", "/app/server.py"]
