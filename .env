# .env does NOT contain secrets — WiFi credentials live in secret.json.

# ── Camera source ──────────────────────────────────────────────────────────
CAMERA_SOURCE=network
WIN_CAMERA_PORT=8081

# ── IoT device identity ────────────────────────────────────────────────────
THING_NAME=esp32p4-device-01

# ── LocalStack ─────────────────────────────────────────────────────────────
LOCALSTACK_AUTH_TOKEN=

# ── AWS CLI (fake values are fine for LocalStack) ──────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
